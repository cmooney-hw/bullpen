{
  "name": "bullpen-widget",
  "productName": "Bullpen",
  "version": "2.9.3",
  "description": "Bullpen: desktop widget with today's JustCall Sales Dialer numbers for the Highwater team",
  "main": "main.js",
  "author": "Highwater",
  "license": "UNLICENSED",
  "scripts": {
    "smoke": "electron smoke.js",
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "com.wearehighwater.callboard",
    "productName": "Bullpen",
    "files": [
      "main.js",
      "preload.js",
      "logic.js",
      "widget.html",
      "cele.html",
      "rig-*.png",
      "hw.png",
      "hw-dark.png",
      "setup.html",
      "icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Bullpen",
      "artifactName": "Bullpen-Setup-${version}.${ext}",
      "include": "build/installer.nsh"
    },
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "cmooney-hw",
      "repo": "bullpen",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cmooney-hw/bullpen.git"
  }
}